# 复制为 .env 并按需修改。MCP 服务器在每次调用时都会读取这些变量。
# （只有当你从 shell 中手动 source .env 时才会加载；
#  在生产环境中请直接在 MCP 客户端配置里设置这些环境变量。）

# 暂停阈值。当 5 小时固定窗口的"剩余百分比"低于此值时，代理应该暂停。
# 网页控制台显示 "已用 N%"，我们对比的是 *剩余* 百分比，
# 所以 30 表示 "剩余低于 30%（即已用超过 70%）时暂停"
# （24/7 长时间运行的代理建议值）。
MINIMAX_PAUSE_THRESHOLD_REMAINING_PCT=30

# 代理本地观测窗口长度（秒）。网页 API 真实返回 start_time / end_time，
# 所以这个值仅作为离线推理的兜底。MiniMax 默认 18000（5 小时）。
MINIMAX_WINDOW_SECONDS=18000

# 调用 minimax_login() 时是否强制显示浏览器窗口。
# 只有当 cookie 已经持久化时才能设为 0；否则用户无法手动完成
# Cloudflare / CAPTCHA 验证。
MINIMAX_HEADFUL_ON_LOGIN=1

# Camoufox 浏览器指纹。OS 在留空时从宿主平台自动检测。
# Locale 默认 zh-CN（MiniMax 网页界面是中文）。
# MINIMAX_CAMOUFOX_OS=
MINIMAX_CAMOUFOX_LOCALE=zh-CN

# API 请求超时（秒）。
MINIMAX_HTTP_TIMEOUT=15

# 持久化目录（默认：包安装目录的 ./data）。
# 也可以指向绝对路径，比如 /var/lib/minimax-remaining-mcp
# MINIMAX_DATA_DIR=/var/lib/minimax-remaining-mcp

# API endpoint 覆盖 —— 仅在测试其他环境时才需要修改。
# MINIMAX_WEB_URL=https://platform.minimaxi.com
# MINIMAX_USAGE_API_URL=https://www.minimaxi.com/backend/account/token_plan_credit
# MINIMAX_REMAINS_API_URL=https://www.minimaxi.com/v1/api/openplatform/coding_plan/remains
# MINIMAX_REMAINS_API_URL_FALLBACK=https://api.minimaxi.com/v1/api/openplatform/coding_plan/remains
# MINIMAX_LOGIN_HINT_URL=https://platform.minimaxi.com/user-center/basic-information/interface-key